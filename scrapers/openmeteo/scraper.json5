{
    // Modular open-meteo scraper: writes the future-dated hourly forecast (incl. radiation) into
    // the SAME InfluxDB series the house has always used — idempotent alongside any other writer.
    // The token comes from the INFLUXDB_TOKEN env var (sourced from the loxone .env at run time);
    // it is never written to this file.
    influx: {
        url: "http://influxdb:8086",   // caddy_net service name (local dev: the SSH tunnel port)
        org: "loxone",
        bucket: "weather_forecast",
    },
    // MUST match `config.json5`'s `site` — this scraper writes the very series the brain reads
    // (`weather_forecast`, room=outside, type=hour: outside temperature + the radiation fields the
    // solar model consumes), so a mismatch silently plans the house against another town's weather.
    site: { latitude: 49.4900, longitude: 17.4300 },
    interval_minutes: 30,
    // MUST be >= mpc_home_control's config.json5 `horizon.hours + horizon.outlook_hours` (default
    // 36 + 36 = 72) — the brain's post-horizon terminal-heat-credit outlook reads straight from
    // this stored forecast and truncates to whatever it actually covers, so a shorter window here
    // silently shrinks the outlook rather than erroring. Raising `horizon.outlook_hours` beyond 36
    // (e.g. to look several days ahead) needs a matching raise here first — open-meteo serves up
    // to 16 days (384 h). Left at 72 (today's live value); NOT raised by this branch.
    horizon_hours: 72,
}
